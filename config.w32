// Windows NTS build configuration for php-bacnet.
// The GitHub Windows workflow builds deps/bacnet-stack/build-windows/Release/bacnet-stack.lib
// before invoking the PHP extension build.
ARG_WITH("bacnet", "BACnet/IP support", "no");

if (PHP_BACNET != "no") {
    var bacnet_root = configure_module_dirname + "\\deps\\bacnet-stack";
    var bacnet_build = bacnet_root + "\\build-windows\\Release";
    var lmdb_root = configure_module_dirname + "\\deps\\lmdb\\libraries\\liblmdb";
    var lmdb_build = configure_module_dirname + "\\deps\\lmdb\\build-windows";

    if (!FSO.FileExists(bacnet_build + "\\bacnet-stack.lib") || !FSO.FileExists(lmdb_build + "\\lmdb.lib")) {
        ERROR("Windows dependencies missing; run scripts/build-windows-deps.ps1 first.");
    }

    ADD_FLAG("CFLAGS_BACNET", "/DBACDL_BIP /DBACNET_STACK_DEPRECATED_DISABLE /DBACNET_STACK_STATIC_DEFINE /I \"" + bacnet_root + "\\src\" /I \"" + bacnet_root + "\\ports\\win32\" /I \"" + lmdb_root + "\"");
    ADD_FLAG("LDFLAGS_BACNET", "/LIBPATH:\"" + bacnet_build + "\" /LIBPATH:\"" + lmdb_build + "\" bacnet-stack.lib lmdb.lib ws2_32.lib");
    EXTENSION("bacnet", "bacnet.c src\\bacnet_client.c src\\bacnet_classes.c src\\bacnet_types.c src\\bacnet_helpers.c src\\bacnet_cache_win32.c src\\bacnet_security.c");
}
